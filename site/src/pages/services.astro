---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { services } from '../data/services';
---

<Layout title="Services — Yard Boys Landscaping" description="Landscaping services in Bucks County, PA: hardscaping, drainage, planting, seasonal cleanup, mulch, gutters, pruning, tree care, snow removal, Christmas lights, and land clearing. Call 215-254-9563.">
  <Navbar />

  <main>
    <!-- ═══════════ HERO ═══════════ -->
    <section class="relative h-[50vh] min-h-[360px] flex items-center justify-center overflow-hidden">
      <div
        class="absolute inset-0 parallax-bg"
        style="background-image: url('/images/hardscape-patio.jpg');"
      ></div>
      <div class="hero-overlay absolute inset-0"></div>

      <div class="relative z-10 text-center px-4">
        <span class="inline-block text-forest-300 text-sm font-semibold uppercase tracking-[0.2em] mb-4 animate-fade-in">What We Offer</span>
        <h1 class="text-5xl sm:text-6xl lg:text-7xl font-black text-white mb-6 animate-fade-in-up" style="animation-delay: 0.2s;">
          Our Services
        </h1>
        <p class="text-white/70 text-lg max-w-2xl mx-auto animate-fade-in-up" style="animation-delay: 0.4s;">
          Pick a service to see what's included and photos of jobs we've done.
        </p>
      </div>
    </section>

    <!-- ═══════════ SERVICE GRID ═══════════ -->
    <section class="py-16 lg:py-20 bg-cream-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {services.map((service, i) => (
            <a
              href={`/services/${service.id}`}
              class="group block bg-white rounded-2xl overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-500 hover:-translate-y-2"
              data-animate
              data-delay={String(Math.min((i % 3 + 1) * 100, 300))}
              id={`services-card-${service.id}`}
            >
              <div class="relative h-56 overflow-hidden">
                <img
                  src={service.image}
                  alt={service.title}
                  class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                  loading="lazy"
                />
                <div class="absolute top-3 left-3 w-12 h-12 bg-forest-600 rounded-xl flex items-center justify-center text-xl shadow-lg">
                  {service.icon}
                </div>
                <div class="absolute bottom-3 right-3 px-3 py-1 rounded-full bg-black/55 text-white text-xs font-medium">
                  {service.gallery.length} {service.gallery.length === 1 ? 'photo' : 'photos'}
                </div>
              </div>
              <div class="p-6">
                <span class="text-forest-600 text-xs font-semibold uppercase tracking-[0.15em]">{service.subtitle}</span>
                <h2 class="text-xl font-bold text-charcoal-700 group-hover:text-forest-600 transition-colors duration-300 mt-1 mb-2">
                  {service.title}
                </h2>
                <p class="text-charcoal-400 text-sm leading-relaxed">{service.summary}</p>
                <div class="mt-4 flex items-center gap-2 text-forest-600 text-sm font-semibold">
                  See Photos &amp; Details
                  <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                  </svg>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══════════ CTA ═══════════ -->
    <section class="relative py-16 lg:py-20 overflow-hidden">
      <div
        class="absolute inset-0 parallax-bg"
        style="background-image: url('/images/hero-aerial.jpeg');"
      ></div>
      <div class="absolute inset-0 bg-charcoal-900/80"></div>

      <div class="relative z-10 max-w-3xl mx-auto px-4 text-center" data-animate>
        <h2 class="text-4xl sm:text-5xl font-bold text-white mb-6">Let's Get Started</h2>
        <p class="text-white/70 text-lg mb-8">Contact Yard Boys today for a free estimate on any of our services.</p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href="tel:2152549563" class="w-full sm:w-auto flex items-center justify-center gap-3 px-8 py-4 bg-forest-600 hover:bg-forest-500 text-white font-bold text-lg rounded-full transition-all duration-300 shadow-xl hover:-translate-y-1">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            215-254-9563
          </a>
          <a href="/contact" class="w-full sm:w-auto px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-semibold rounded-full backdrop-blur-sm border border-white/20 transition-all duration-300 hover:-translate-y-1">
            Request a Free Estimate
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
