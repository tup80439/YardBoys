---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import BeforeAfterVertical from '../components/BeforeAfterVertical.astro';

const services = [
  {
    id: 'landscape-design-hardscaping',
    title: 'Landscape Design & Hardscaping',
    subtitle: 'Design Through to Build',
    description: 'From concept to completion — we design and build patios, walkways, retaining walls, and outdoor living spaces that transform how you use your property. Whether it\'s a full patio build, a new stone walkway, or a custom retaining wall, our team handles every phase with precision and quality craftsmanship. This is what we do best.',
    image: '/images/landscape-costruction.png',
    icon: '🏗️',
  },
  {
    id: 'drainage-work',
    title: 'Drainage Work',
    subtitle: 'Water Management Solutions',
    description: 'Standing water, erosion, and runoff don\'t fix themselves — and band-aid solutions only make things worse. We diagnose the root cause and install proper drainage systems that redirect water where it belongs, protecting your foundation, beds, and hardscaping for the long term.',
    image: '/images/front-walk-after.png',
    icon: '💧',
  },
  {
    id: 'planting',
    title: 'Planting',
    subtitle: 'Trees, Shrubs & Flower Beds',
    description: 'Tree, shrub, and flower bed installs planned around what will actually thrive in your yard. We consider sunlight, soil conditions, and long-term growth so your plantings look great now and years down the road — not just the week they go in.',
    image: '/images/mulch-bed-flowers.jpg',
    icon: '🌱',
  },
  {
    id: 'seasonal-cleanup',
    title: 'Seasonal Clean Up',
    subtitle: 'Spring & Fall Property Care',
    description: 'Seasonal clean ups that clear leaves, debris, and overgrowth — leaving the property looking sharp for the season ahead. We handle everything from bed edging and leaf removal to brush clearing and hauling, so your yard is ready when you are.',
    image: '/images/front-corner-after-edited.png',
    icon: '🍂',
  },
  {
    id: 'mulch-delivery',
    title: 'Mulch Delivery & Installation',
    subtitle: 'Premium Mulch Solutions',
    description: 'Enhance your garden\'s health and curb appeal with our premium mulch delivery and installation services. We offer a variety of high-quality mulch options suited to your landscaping needs, including organic and decorative types. Our expert team ensures even coverage and optimal placement to promote soil moisture retention, temperature regulation, and weed suppression.',
    image: '/images/mulch-delivery.jpg',
    icon: '🌿',
  },
  {
    id: 'gutter-work',
    title: 'Gutter Work',
    subtitle: 'Cleaning & Repair',
    description: 'Gutter cleaning and repair so water goes where it\'s supposed to — instead of into your foundation or beds. Clogged or damaged gutters cause problems that compound fast. We clean, repair, and make sure everything\'s draining properly before we leave.',
    image: '/images/facade-after-edited-1.png',
    icon: '🏠',
  },
  {
    id: 'pruning-trimming',
    title: 'Pruning & Trimming',
    subtitle: 'Expert Plant Care',
    description: 'We specialize in professional pruning and trimming services to keep your landscape looking its best. From shaping bushes and hedges to pruning trees for healthy growth, our skilled team ensures precise and effective results. We prioritize both aesthetic appeal and plant health with every job we undertake.',
    image: '/images/prunning-trimming.png',
    icon: '✂️',
  },
  {
    id: 'snow-removal',
    title: 'Snow Removal',
    subtitle: 'Winter Weather Solutions',
    description: 'When winter weather strikes, count on our dedicated team to clear driveways, walkways, and parking lots efficiently and safely. We use professional-grade equipment to ensure thorough snow removal without damaging your property. Whether you need one-time assistance or ongoing maintenance throughout the season, we keep your spaces safe and accessible.',
    image: '/images/snow-removal.jpg',
    icon: '❄️',
  },
  {
    id: 'christmas-lights',
    title: 'Christmas Lights',
    subtitle: 'Holiday Light Installation',
    description: 'Holiday light installation and takedown — we handle the ladders, clips, and layout so you can enjoy the season without the hassle. Residential and commercial properties.',
    image: '/images/christmas-lights-finished.jpg',
    icon: '🎄',
  },
];
---

<Layout title="Services — Yard Boys Landscaping" description="Professional landscaping services including landscape design & hardscaping, drainage work, seasonal cleanup, mulch delivery, pruning & trimming, and snow removal. Call (215) 327-6144.">
  <Navbar />

  <main>
    <!-- ═══════════ HERO ═══════════ -->
    <section class="relative h-[60vh] min-h-[400px] flex items-center justify-center overflow-hidden">
      <div
        class="absolute inset-0 parallax-bg"
        style="background-image: url('/images/landscape-costruction.png');"
      ></div>
      <div class="hero-overlay absolute inset-0"></div>

      <div class="relative z-10 text-center px-4">
        <span class="inline-block text-forest-300 text-sm font-semibold uppercase tracking-[0.2em] mb-4 animate-fade-in">What We Offer</span>
        <h1 class="text-5xl sm:text-6xl lg:text-7xl font-black text-white mb-6 animate-fade-in-up" style="animation-delay: 0.2s;">
          Our Services
        </h1>
        <p class="text-white/70 text-lg max-w-2xl mx-auto animate-fade-in-up" style="animation-delay: 0.4s;">
          From landscape design and patio construction to seasonal maintenance — Yard Boys handles every phase of your outdoor project.
        </p>
      </div>
    </section>

    <!-- ═══════════ SERVICE SECTIONS ═══════════ -->
    {services.map((service, index) => (
      <section
        id={service.id}
        class={`py-20 lg:py-28 ${index % 2 === 0 ? 'bg-white' : 'bg-cream-50'}`}
      >
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class={`grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center ${index % 2 !== 0 ? 'lg:[direction:rtl]' : ''}`}>
            <!-- Image -->
            <div class={`relative ${index % 2 !== 0 ? 'lg:[direction:ltr]' : ''}`} data-animate={index % 2 === 0 ? 'left' : 'right'}>
              <div class="rounded-2xl overflow-hidden shadow-2xl group">
                <img
                  src={service.image}
                  alt={service.title}
                  class="w-full h-[350px] sm:h-[450px] object-cover transition-transform duration-700 group-hover:scale-105"
                  loading="lazy"
                />
              </div>
              <!-- Service badge -->
              <div class="absolute -top-4 -left-4 w-16 h-16 bg-forest-600 rounded-2xl flex items-center justify-center text-2xl shadow-xl">
                {service.icon}
              </div>
            </div>

            <!-- Content -->
            <div class={index % 2 !== 0 ? 'lg:[direction:ltr]' : ''} data-animate={index % 2 === 0 ? 'right' : 'left'}>
              <span class="inline-block text-forest-600 text-sm font-semibold uppercase tracking-[0.2em] mb-3">
                {service.subtitle}
              </span>
              <h2 class="text-3xl sm:text-4xl font-bold text-charcoal-700 mb-6">{service.title}</h2>
              <p class="text-charcoal-500 leading-relaxed text-lg mb-6">
                {service.description}
              </p>

              <a
                href="/contact"
                class="inline-flex items-center gap-2 px-8 py-4 bg-forest-600 hover:bg-forest-500 text-white font-semibold rounded-full transition-all duration-300 shadow-lg hover:shadow-forest-500/25 hover:-translate-y-1"
                id={`service-cta-${service.id}`}
              >
                Get a Free Estimate
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </a>
            </div>
          </div>
        </div>
      </section>
    ))}

    <!-- ═══════════ BEFORE / AFTER ═══════════ -->
    <section class="py-24 lg:py-32 bg-charcoal-700">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12" data-animate>
          <span class="inline-block text-forest-300 text-sm font-semibold uppercase tracking-[0.2em] mb-4">Real Results</span>
          <h2 class="text-4xl sm:text-5xl font-bold text-white mb-4">Before & After</h2>
          <p class="text-white/60 max-w-xl mx-auto text-lg">
            See the dramatic transformation Yard Boys delivers. Drag the slider to compare.
          </p>
        </div>

        <BeforeAfterVertical
          beforeSrc="/images/patio-overgrowth-before.jpg"
          afterSrc="/images/patio-overgrowth-after.jpg"
          beforeAlt="Patio area overgrown with weeds and debris before Yard Boys cleanup"
          afterAlt="Patio area fully cleared and restored after Yard Boys transformation"
        />
      </div>
    </section>

    <!-- ═══════════ GALLERY STRIP ═══════════ -->
    <section class="py-20 bg-cream-50 overflow-hidden">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12" data-animate>
          <span class="inline-block text-forest-600 text-sm font-semibold uppercase tracking-[0.2em] mb-4">Our Portfolio</span>
          <h2 class="text-4xl font-bold text-charcoal-700 mb-4">Recent Projects</h2>
          <p class="text-charcoal-400">Yard Boys provides comprehensive care to both residential and commercial properties.</p>
        </div>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          <div class="rounded-xl overflow-hidden shadow-lg aspect-square" data-animate data-delay="100">
            <img src="/images/patio-overgrowth-after.jpg" alt="Patio overgrowth cleanup project completed" class="w-full h-full object-cover hover:scale-110 transition-transform duration-700" loading="lazy" />
          </div>
          <div class="rounded-xl overflow-hidden shadow-lg aspect-square" data-animate data-delay="200">
            <img src="/images/front-walk-after.png" alt="Front walk landscaping project" class="w-full h-full object-cover hover:scale-110 transition-transform duration-700" loading="lazy" />
          </div>
          <div class="rounded-xl overflow-hidden shadow-lg aspect-square" data-animate data-delay="300">
            <img src="/images/facade-after-edited-1.png" alt="House facade landscaping" class="w-full h-full object-cover hover:scale-110 transition-transform duration-700" loading="lazy" />
          </div>
          <div class="rounded-xl overflow-hidden shadow-lg aspect-square" data-animate data-delay="400">
            <img src="/images/finished-front-house.jpg" alt="Completed front yard landscaping" class="w-full h-full object-cover hover:scale-110 transition-transform duration-700" loading="lazy" />
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════ CTA ═══════════ -->
    <section class="relative py-24 overflow-hidden">
      <div
        class="absolute inset-0 parallax-bg"
        style="background-image: url('/images/hero-aerial.jpeg');"
      ></div>
      <div class="absolute inset-0 bg-charcoal-900/80"></div>

      <div class="relative z-10 max-w-3xl mx-auto px-4 text-center" data-animate>
        <h2 class="text-4xl sm:text-5xl font-bold text-white mb-6">Let's Get Started</h2>
        <p class="text-white/70 text-lg mb-8">Contact Yard Boys today for a free estimate on any of our services.</p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href="tel:2153276144" class="w-full sm:w-auto flex items-center justify-center gap-3 px-8 py-4 bg-forest-600 hover:bg-forest-500 text-white font-bold text-lg rounded-full transition-all duration-300 shadow-xl hover:-translate-y-1">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            (215) 327-6144
          </a>
          <a href="/contact" class="w-full sm:w-auto px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-semibold rounded-full backdrop-blur-sm border border-white/20 transition-all duration-300 hover:-translate-y-1">
            Request a Free Estimate
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
