---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Terms and Conditions — Yard Boys LLC" description="Terms and Conditions for Yard Boys LLC. Review the terms governing our services and communications.">
  <Navbar />

  <main>
    <!-- Hero -->
    <section class="relative bg-charcoal-700 pt-32 pb-16 sm:pt-36 sm:pb-20">
      <div class="absolute inset-0 bg-gradient-to-b from-charcoal-800 to-charcoal-700"></div>
      <div class="relative z-10 text-center px-4">
        <span class="inline-block text-forest-300 text-sm font-semibold uppercase tracking-[0.2em] mb-4 animate-fade-in">Legal</span>
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-black text-white mb-4 animate-fade-in-up" style="animation-delay: 0.2s;">
          Terms and Conditions
        </h1>
      </div>
    </section>

    <!-- Content -->
    <section class="py-16 sm:py-20 bg-cream-50">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="bg-white rounded-2xl shadow-lg p-8 sm:p-12 space-y-8" data-animate>

          <p class="text-charcoal-400 text-sm font-medium">Last updated: September 2, 2026</p>

          <p class="text-charcoal-600 leading-relaxed">
            By using our services or opting in to receive communications from Yard Boys LLC, you agree to the following terms.
          </p>

          <div>
            <h2 class="text-xl font-bold text-charcoal-700 mb-3">Services</h2>
            <p class="text-charcoal-600 leading-relaxed">
              Yard Boys LLC provides residential landscaping services in Bucks County, PA, including but not limited to lawn maintenance, cleanups, mulching, landscape design, and related services. Pricing and scheduling are provided upon request and may vary based on property size and scope of work.
            </p>
          </div>

          <div>
            <h2 class="text-xl font-bold text-charcoal-700 mb-3">Text Messaging Program</h2>
            <p class="text-charcoal-600 leading-relaxed">
              By providing your phone number, you consent to receive text messages from Yard Boys LLC related to service updates, appointment reminders, and promotional offers. Message and data rates may apply. Message frequency varies depending on your service activity and preferences. You may opt out at any time by replying STOP to any message. For help, reply HELP or contact us at
              <a href="tel:2152549563" class="text-forest-600 hover:text-forest-500 font-medium transition-colors duration-300">(215) 254-9563</a>.
            </p>
          </div>

          <div>
            <h2 class="text-xl font-bold text-charcoal-700 mb-3">Payment</h2>
            <p class="text-charcoal-600 leading-relaxed">
              Payment terms will be discussed and agreed upon at the time of booking. A deposit may be required for certain services.
            </p>
          </div>

          <div>
            <h2 class="text-xl font-bold text-charcoal-700 mb-3">Limitation of Liability</h2>
            <p class="text-charcoal-600 leading-relaxed">
              Yard Boys LLC performs all work with care and professionalism. We are not liable for pre-existing property conditions or damage resulting from circumstances outside our control.
            </p>
          </div>

          <div>
            <h2 class="text-xl font-bold text-charcoal-700 mb-3">Contact Us</h2>
            <p class="text-charcoal-600 leading-relaxed">
              Questions about these terms can be directed to
              <a href="mailto:office@yardboysllc.com" class="text-forest-600 hover:text-forest-500 font-medium transition-colors duration-300">office@yardboysllc.com</a>
              or
              <a href="tel:2152549563" class="text-forest-600 hover:text-forest-500 font-medium transition-colors duration-300">(215) 254-9563</a>.
            </p>
          </div>

        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
