---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Privacy Policy — Yard Boys LLC" description="Privacy Policy for Yard Boys LLC. Learn how we collect, use, and protect your information.">
  <Navbar />

  <main>
    <!-- Hero -->
    <section class="relative bg-charcoal-700 pt-32 pb-16 sm:pt-36 sm:pb-20">
      <div class="absolute inset-0 bg-gradient-to-b from-charcoal-800 to-charcoal-700"></div>
      <div class="relative z-10 text-center px-4">
        <span class="inline-block text-forest-300 text-sm font-semibold uppercase tracking-[0.2em] mb-4 animate-fade-in">Legal</span>
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-black text-white mb-4 animate-fade-in-up" style="animation-delay: 0.2s;">
          Privacy Policy
        </h1>
      </div>
    </section>

    <!-- Content -->
    <section class="py-16 sm:py-20 bg-cream-50">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="bg-white rounded-2xl shadow-lg p-8 sm:p-12 space-y-8" data-animate>

          <p class="text-charcoal-400 text-sm font-medium">Last updated: September 2, 2026</p>

          <p class="text-charcoal-600 leading-relaxed">
            Yard Boys LLC ("we," "us," or "our") respects your privacy. This policy explains how we collect, use, and protect your information.
          </p>

          <div>
            <h2 class="text-xl font-bold text-charcoal-700 mb-3">Information We Collect</h2>
            <p class="text-charcoal-600 leading-relaxed">
              We may collect your name, phone number, email address, and property address when you request a quote, book a service, or sign up for updates from us.
            </p>
          </div>

          <div>
            <h2 class="text-xl font-bold text-charcoal-700 mb-3">How We Use Your Information</h2>
            <p class="text-charcoal-600 leading-relaxed">
              We use your information to provide landscaping services, respond to inquiries, schedule appointments, and send you service-related updates and occasional promotional messages if you have opted in.
            </p>
          </div>

          <div>
            <h2 class="text-xl font-bold text-charcoal-700 mb-3">Text Messaging</h2>
            <p class="text-charcoal-600 leading-relaxed mb-4">
              If you provide your phone number and opt in to receive text messages from Yard Boys LLC, we may send you appointment reminders, service updates, and promotional offers. Message and data rates may apply. Message frequency varies. You can opt out at any time by replying STOP, or get help by replying HELP.
            </p>
            <p class="text-charcoal-600 leading-relaxed">
              We do not sell or share your phone number or personal information with third parties for their marketing purposes. Your information is used solely by Yard Boys LLC to provide and improve our services to you.
            </p>
          </div>

          <div>
            <h2 class="text-xl font-bold text-charcoal-700 mb-3">Contact Us</h2>
            <p class="text-charcoal-600 leading-relaxed">
              If you have questions about this privacy policy, contact us at
              <a href="mailto:office@yardboysllc.com" class="text-forest-600 hover:text-forest-500 font-medium transition-colors duration-300">office@yardboysllc.com</a>
              or
              <a href="tel:2152549563" class="text-forest-600 hover:text-forest-500 font-medium transition-colors duration-300">(215) 254-9563</a>.
            </p>
          </div>

        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
