---
interface Props {
  beforeSrc: string;
  afterSrc: string;
  beforeAlt?: string;
  afterAlt?: string;
}

const { beforeSrc, afterSrc, beforeAlt = 'Before', afterAlt = 'After' } = Astro.props;
---

<div class="before-after-wrapper relative" data-animate>
  <div class="flex items-center gap-2 mb-4">
    <div class="h-px flex-1 bg-gradient-to-r from-transparent to-forest-500/30"></div>
    <span class="text-xs font-semibold uppercase tracking-[0.2em] text-forest-600">Drag to Compare</span>
    <div class="h-px flex-1 bg-gradient-to-l from-transparent to-forest-500/30"></div>
  </div>

  <div class="relative rounded-2xl overflow-hidden shadow-2xl">
    <!-- Labels -->
    <span data-label="before" class="ba-label absolute top-4 left-4 z-10 px-3 py-1 text-xs font-bold uppercase tracking-wider bg-black/60 backdrop-blur-sm text-white rounded-full flex items-center gap-1.5 border border-white/10 select-none">
      <span class="w-1.5 h-1.5 rounded-full bg-red-400"></span>
      Before
    </span>
    <span data-label="after" class="ba-label absolute bottom-4 right-4 z-10 px-3 py-1 text-xs font-bold uppercase tracking-wider bg-forest-600/90 backdrop-blur-sm text-white rounded-full flex items-center gap-1.5 border border-white/10 select-none">
      After
      <span class="w-1.5 h-1.5 rounded-full bg-white"></span>
    </span>

    <img-comparison-slider class="w-full">
      <img slot="first" src={beforeSrc} alt={beforeAlt} class="w-full h-full object-cover" />
      <img slot="second" src={afterSrc} alt={afterAlt} class="w-full h-full object-cover" />
      <div slot="handle" class="w-11 h-11 flex items-center justify-center cursor-grab active:cursor-grabbing">
        <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 7l-5 5 5 5M15 7l5 5-5 5" />
        </svg>
      </div>
    </img-comparison-slider>
  </div>
</div>

<style>
  .ba-label {
    transition: opacity 0.25s ease;
  }

  .ba-label.ba-label-hidden {
    opacity: 0;
    pointer-events: none;
  }
</style>

<script>
  import 'img-comparison-slider';

  function initHorizontalSliders() {
    document.querySelectorAll('.before-after-wrapper').forEach((wrapper) => {
      const slider = wrapper.querySelector('img-comparison-slider') as any;
      const beforeLabel = wrapper.querySelector('[data-label="before"]') as HTMLElement | null;
      const afterLabel = wrapper.querySelector('[data-label="after"]') as HTMLElement | null;

      if (!slider || slider.dataset.horizInit === 'true') return;
      slider.dataset.horizInit = 'true';

      function updateLabels() {
        const val = slider.value ?? 50;
        if (beforeLabel) {
          beforeLabel.classList.toggle('ba-label-hidden', val <= 5);
        }
        if (afterLabel) {
          afterLabel.classList.toggle('ba-label-hidden', val >= 95);
        }
      }

      slider.addEventListener('slide', updateLabels);
      updateLabels();
    });
  }

  initHorizontalSliders();
  document.addEventListener('astro:page-load', initHorizontalSliders);
</script>
