---
interface Props {
  beforeSrc: string;
  afterSrc: string;
  beforeAlt?: string;
  afterAlt?: string;
}

const { beforeSrc, afterSrc, beforeAlt = 'Before', afterAlt = 'After' } = Astro.props;
---

<div class="ba-slider ba-slider--horiz" data-animate>
  <div class="flex items-center gap-2 mb-4">
    <div class="h-px flex-1 bg-gradient-to-r from-transparent to-forest-500/30"></div>
    <span class="text-xs font-semibold uppercase tracking-[0.2em] text-forest-600">Drag to Compare</span>
    <div class="h-px flex-1 bg-gradient-to-l from-transparent to-forest-500/30"></div>
  </div>

  <div class="ba-slider__container">
    <!-- After image (bottom layer) -->
    <img src={afterSrc} alt={afterAlt} class="ba-slider__img" draggable="false" />

    <!-- Before image (top layer, clipped) -->
    <img
      src={beforeSrc}
      alt={beforeAlt}
      class="ba-slider__img ba-slider__before ba-slider__before--horiz"
      draggable="false"
      style="clip-path: inset(0 50% 0 0)"
    />

    <!-- Labels -->
    <span class="ba-slider__label ba-slider__label--before">
      <span class="ba-slider__label-dot ba-slider__label-dot--red"></span>
      Before
    </span>
    <span class="ba-slider__label ba-slider__label--after">
      After
      <span class="ba-slider__label-dot ba-slider__label-dot--white"></span>
    </span>

    <!-- Divider line (vertical) -->
    <div class="ba-slider__divider ba-slider__divider--horiz" style="left: 50%"></div>

    <!-- Drag handle -->
    <div class="ba-slider__handle ba-slider__handle--horiz" style="left: 50%">
      <svg class="ba-slider__handle-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 7l-5 5 5 5M15 7l5 5-5 5" />
      </svg>
    </div>
  </div>
</div>

<style>
  /* Horizontal-specific overrides (base styles come from BeforeAfterVertical) */

  .ba-slider__divider--horiz {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 3px;
    height: auto;
    left: 50%;
    background: #4A7C2E;
    z-index: 3;
    transform: translateX(-50%);
    pointer-events: none;
  }

  .ba-slider__handle--horiz {
    position: absolute;
    top: 50%;
    z-index: 4;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: #4A7C2E;
    border: 3px solid #fff;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.25);
    display: flex;
    align-items: center;
    justify-content: center;
    transform: translate(-50%, -50%);
    cursor: grab;
    touch-action: none;
  }

  .ba-slider__handle--horiz:active {
    cursor: grabbing;
  }
</style>

<script>
  function initHorizSliders() {
    document.querySelectorAll('.ba-slider--horiz').forEach((root) => {
      if ((root as HTMLElement).dataset.sliderInit === '1') return;
      (root as HTMLElement).dataset.sliderInit = '1';

      const container = root.querySelector('.ba-slider__container') as HTMLElement;
      const beforeImg = root.querySelector('.ba-slider__before--horiz') as HTMLImageElement;
      const handle = root.querySelector('.ba-slider__handle--horiz') as HTMLElement;
      const divider = root.querySelector('.ba-slider__divider--horiz') as HTMLElement;
      const beforeLabel = root.querySelector('.ba-slider__label--before') as HTMLElement | null;
      const afterLabel = root.querySelector('.ba-slider__label--after') as HTMLElement | null;

      if (!container || !beforeImg || !handle || !divider) return;

      let pct = 50; // 0 = all after (before hidden), 100 = all before

      function render() {
        // clip-path: inset(0 RIGHT% 0 0) — RIGHT% is how much to hide from the right
        const hideRight = 100 - pct;
        beforeImg.style.clipPath = `inset(0 ${hideRight}% 0 0)`;
        handle.style.left = `${pct}%`;
        divider.style.left = `${pct}%`;

        if (beforeLabel) beforeLabel.classList.toggle('hidden', pct <= 5);
        if (afterLabel) afterLabel.classList.toggle('hidden', pct >= 95);
      }

      let dragging = false;

      handle.addEventListener('pointerdown', (e: PointerEvent) => {
        e.preventDefault();
        dragging = true;
        handle.setPointerCapture(e.pointerId);
      });

      handle.addEventListener('pointermove', (e: PointerEvent) => {
        if (!dragging) return;
        const rect = container.getBoundingClientRect();
        const x = e.clientX - rect.left;
        pct = Math.max(0, Math.min(100, (x / rect.width) * 100));
        render();
      });

      handle.addEventListener('pointerup', () => { dragging = false; });
      handle.addEventListener('pointercancel', () => { dragging = false; });

      container.addEventListener('pointerdown', (e: PointerEvent) => {
        if (e.target === handle || handle.contains(e.target as Node)) return;
        const rect = container.getBoundingClientRect();
        const x = e.clientX - rect.left;
        pct = Math.max(0, Math.min(100, (x / rect.width) * 100));
        render();
      });

      container.addEventListener('click', (e: Event) => {
        e.preventDefault();
        e.stopPropagation();
      });

      render();
    });
  }

  initHorizSliders();
  document.addEventListener('astro:page-load', initHorizSliders);
</script>
