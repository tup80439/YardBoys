---
interface Props {
  beforeSrc: string;
  afterSrc: string;
  beforeAlt?: string;
  afterAlt?: string;
}

const { beforeSrc, afterSrc, beforeAlt = 'Before', afterAlt = 'After' } = Astro.props;
---

<div class="before-after-vertical-wrapper relative" data-animate>
  <div class="flex items-center gap-2 mb-4">
    <div class="h-px flex-1 bg-gradient-to-r from-transparent to-forest-500/30"></div>
    <span class="text-xs font-semibold uppercase tracking-[0.2em] text-forest-600">Slide to Compare</span>
    <div class="h-px flex-1 bg-gradient-to-l from-transparent to-forest-500/30"></div>
  </div>

  <div class="relative rounded-2xl overflow-hidden shadow-2xl">
    <!-- Labels -->
    <span class="absolute top-4 left-4 z-10 px-3 py-1 text-xs font-bold uppercase tracking-wider bg-black/60 backdrop-blur-sm text-white rounded-full flex items-center gap-1.5 border border-white/10 select-none">
      <span class="w-1.5 h-1.5 rounded-full bg-red-400"></span>
      Before
    </span>
    <span class="absolute bottom-4 right-4 z-10 px-3 py-1 text-xs font-bold uppercase tracking-wider bg-forest-600/90 backdrop-blur-sm text-white rounded-full flex items-center gap-1.5 border border-white/10 select-none">
      After
      <span class="w-1.5 h-1.5 rounded-full bg-white"></span>
    </span>

    <img-comparison-slider class="w-full" direction="vertical">
      <img slot="first" src={beforeSrc} alt={beforeAlt} class="w-full h-full object-cover" />
      <img slot="second" src={afterSrc} alt={afterAlt} class="w-full h-full object-cover" />
      <div slot="handle" class="w-11 h-11 flex items-center justify-center cursor-grab active:cursor-grabbing">
        <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M7 9l5-5 5 5M7 15l5 5 5-5" />
        </svg>
      </div>
    </img-comparison-slider>
  </div>
</div>

<script>
  import 'img-comparison-slider';
</script>
