---
interface Props {
  beforeSrc: string;
  afterSrc: string;
  beforeAlt?: string;
  afterAlt?: string;
}

const { beforeSrc, afterSrc, beforeAlt = 'Before', afterAlt = 'After' } = Astro.props;
---

<div class="before-after-vertical-wrapper relative" data-animate>
  <div class="flex items-center gap-2 mb-4">
    <div class="h-px flex-1 bg-gradient-to-r from-transparent to-forest-500/30"></div>
    <span class="text-xs font-semibold uppercase tracking-[0.2em] text-forest-600">Slide to Compare</span>
    <div class="h-px flex-1 bg-gradient-to-l from-transparent to-forest-500/30"></div>
  </div>

  <div class="relative rounded-2xl overflow-hidden shadow-2xl">
    <!-- Labels -->
    <span data-label="before" class="ba-label absolute top-4 left-4 z-10 px-3 py-1 text-xs font-bold uppercase tracking-wider bg-black/60 backdrop-blur-sm text-white rounded-full flex items-center gap-1.5 border border-white/10 select-none">
      <span class="w-1.5 h-1.5 rounded-full bg-red-400"></span>
      Before
    </span>
    <span data-label="after" class="ba-label absolute bottom-4 right-4 z-10 px-3 py-1 text-xs font-bold uppercase tracking-wider bg-forest-600/90 backdrop-blur-sm text-white rounded-full flex items-center gap-1.5 border border-white/10 select-none">
      After
      <span class="w-1.5 h-1.5 rounded-full bg-white"></span>
    </span>

    <img-comparison-slider class="w-full" direction="vertical">
      <img slot="first" src={beforeSrc} alt={beforeAlt} class="w-full h-full object-cover" />
      <img slot="second" src={afterSrc} alt={afterAlt} class="w-full h-full object-cover" />
      <!-- Counter-rotate -90deg to undo library's shadow DOM rotate(90deg) on vertical handles -->
      <div slot="handle" class="w-11 h-11 flex items-center justify-center cursor-grab active:cursor-grabbing" style="transform: rotate(-90deg)">
        <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M7 9l5-5 5 5M7 15l5 5 5-5" />
        </svg>
      </div>
    </img-comparison-slider>
  </div>

  <!-- Tap-to-toggle fallback (touch devices only) -->
  <button class="ba-vertical-toggle" type="button" aria-label="Toggle before and after">
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16V4m0 0L3 8m4-4l4 4m6 0v12m0 0l4-4m-4 4l-4-4" />
    </svg>
    Tap to toggle
  </button>
</div>

<style>
  .ba-label {
    transition: opacity 0.25s ease;
  }

  .ba-label.ba-label-hidden {
    opacity: 0;
    pointer-events: none;
  }

  .ba-vertical-toggle {
    display: none;
  }

  @media (hover: none) and (pointer: coarse) {
    .ba-vertical-toggle {
      display: inline-flex;
      align-items: center;
      gap: 0.375rem;
      margin-top: 0.75rem;
      margin-left: auto;
      margin-right: auto;
      padding: 0.375rem 0.875rem;
      font-size: 0.75rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: #4A7C2E;
      background: rgba(74, 124, 46, 0.08);
      border: 1px solid rgba(74, 124, 46, 0.2);
      border-radius: 9999px;
      cursor: pointer;
      transition: all 0.2s;
      width: fit-content;
    }

    .ba-vertical-toggle:active {
      background: rgba(74, 124, 46, 0.18);
    }

    /* Center the button under the slider */
    .before-after-vertical-wrapper {
      display: flex;
      flex-direction: column;
      align-items: center;
    }
  }
</style>

<script>
  import 'img-comparison-slider';

  function initVerticalSliders() {
    document.querySelectorAll('.before-after-vertical-wrapper').forEach((wrapper) => {
      const slider = wrapper.querySelector('img-comparison-slider') as any;
      const toggle = wrapper.querySelector('.ba-vertical-toggle') as HTMLButtonElement | null;
      const beforeLabel = wrapper.querySelector('[data-label="before"]') as HTMLElement | null;
      const afterLabel = wrapper.querySelector('[data-label="after"]') as HTMLElement | null;

      if (!slider || slider.dataset.vertInit === 'true') return;
      slider.dataset.vertInit = 'true';

      // ── Defensive: stop ALL clicks/taps inside the slider from bubbling ──
      // This prevents any parent <a>, document-level handler (e.g. Lightbox),
      // or browser-default behavior from intercepting slider interactions.
      slider.addEventListener('click', (e: Event) => {
        e.preventDefault();
        e.stopPropagation();
      }, true); // capture phase — catches before anything else

      // Also block on the wrapper itself, so edge-taps near the slider
      // that land on the wrapper div don't bubble to a parent link.
      wrapper.addEventListener('click', (e: Event) => {
        // Allow the toggle button to work
        if ((e.target as HTMLElement).closest('.ba-vertical-toggle')) return;
        e.preventDefault();
        e.stopPropagation();
      });

      // Block touch events from propagating out of the slider
      // (prevents Lightbox touchend handler from catching these)
      for (const evt of ['touchstart', 'touchmove', 'touchend'] as const) {
        slider.addEventListener(evt, (e: Event) => {
          e.stopPropagation();
        });
      }

      // --- Label visibility tied to slider position ---
      function updateLabels() {
        const val = slider.value ?? 50;
        if (beforeLabel) {
          beforeLabel.classList.toggle('ba-label-hidden', val <= 5);
        }
        if (afterLabel) {
          afterLabel.classList.toggle('ba-label-hidden', val >= 95);
        }
      }

      slider.addEventListener('slide', updateLabels);
      // Run once on init in case value starts at an extreme
      updateLabels();

      // --- Tap-to-toggle fallback ---
      if (toggle && toggle.dataset.init !== 'true') {
        toggle.dataset.init = 'true';

        let showingAfter = false;

        toggle.addEventListener('click', (e: Event) => {
          e.stopPropagation(); // don't let this bubble to wrapper's click blocker
          showingAfter = !showingAfter;
          slider.value = showingAfter ? 100 : 0;
          // Update labels after programmatic toggle
          updateLabels();
        });
      }
    });
  }

  initVerticalSliders();
  document.addEventListener('astro:page-load', initVerticalSliders);
</script>
